# Bee node
BEE_PASSWORD=change-me
BEE_BLOCKCHAIN_RPC_ENDPOINT=https://rpc.gnosischain.com
# Optional: public IP:1634 of this host, so other Bee nodes can reach the node
BEE_NAT_ADDR=
# Host ports, only worth changing while an old node still holds the defaults
BEE_API_PORT=1633
BEE_P2P_PORT=1634
# Only needed if browsers should call this node directly, e.g. https://beechan.bzz.limo
BEE_CORS_ALLOWED_ORIGINS=

# Backend - MB_SIGNER must publish as the MB_ADDRESS in shared/src/index.ts
MB_SIGNER=
MB_STAMP=
